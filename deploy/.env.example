# ============================================================================
# Agentic SDLC OS — 单机私有化环境配置模板 (.env.example)
# ============================================================================

# --- Web 服务与运行模式 ---
PORT=4300
NODE_ENV=development
WORKFLOW_DSL_PATH=./configs/workflows/enterprise_sdlc.yaml

# --- 登录鉴权与 HTTP 安全守卫 ---
# AUTH_REQUIRED=true 时要求真实登录会话；AUTH_DISABLED=true 仅限本地极速联调使用
AUTH_REQUIRED=true
AUTH_DISABLED=false
COOKIE_SECURE=false
HTTP_MAX_BODY_BYTES=1048576
HTTP_BODY_TIMEOUT_MS=15000
HTTP_LOGIN_RATE_LIMIT=20
HTTP_EXPENSIVE_RATE_LIMIT=30

# --- BYOM 混合模型路由与向量检索 (LiteLLM / Ollama / vLLM / OpenAI 兼容端点) ---
# 当 LITELLM_ENABLE_LIVE_HTTP=true 时向真实推理网关发起请求；否则使用内置确定性契约合成引擎
LITELLM_ENABLE_LIVE_HTTP=false
LITELLM_GATEWAY_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-onpremise-placeholder
LLM_TIMEOUT_MS=60000
OLLAMA_API_BASE=http://localhost:11434
EMBEDDING_MODEL=bge-m3-local
# bge-m3 默认为 1024 维；OpenAI text-embedding-3-small 为 1536 维
RAG_VECTOR_DIM=1024
PG_RAG_VECTOR_DIM=1024
SEMANTIC_CACHE_THRESHOLD=0.88
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 持久化存储与 PG 连接性能调优 ---
DATABASE_URL=postgresql://sdlc_admin:sdlc_secret@localhost:5432/agentic_sdlc
POSTGRES_PASSWORD=sdlc_secret
LOCAL_PERSISTENCE_DIR=./.runtime-data
PG_SESSION_CACHE_TTL_MS=15000
PG_SESSION_TOUCH_THROTTLE_MS=60000

# --- 隔离代码与测试沙箱配置 ---
SANDBOX_RUNTIME=host
SANDBOX_DOCKER_IMAGE=node:22-alpine
SANDBOX_WORKTREE_ROOT=./.sandbox-worktrees
SANDBOX_WORKTREE_RETENTION=5
GIT_REPO_PATH=.

# --- 企业外部集成与 MCP 工具网关（可选 / 按 P2-1 按需启用） ---
MCP_AUTH_TOKEN=
FIGMA_MCP_URL=
WAREHOUSE_MCP_URL=
WAREHOUSE_CONNECTION_STRING=
