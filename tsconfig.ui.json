{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./src/ui/dist",
    "rootDir": "./src/ui"
  },
  "include": [
    "src/ui/client/**/*.ts",
    "src/ui/client/**/*.tsx",
    "src/ui/kit/**/*.ts",
    "src/ui/kit/**/*.tsx"
  ],
  "exclude": ["node_modules", "src/ui/dist"]
}
